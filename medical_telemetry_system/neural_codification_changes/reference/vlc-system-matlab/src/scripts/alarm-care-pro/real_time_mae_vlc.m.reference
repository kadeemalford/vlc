 function varargout = real_time_mae_vlc(arg1, arg2)
%REAL_TIME_MAE_VLC Pipeline VLC em tempo real com canal fisico (MDO3012).
%   Equipamentos (clientes TCP) conectam em:
%     porta 2222  = monitor multiparametrico (HL7)
%     porta 23000 = ventilador (HL7)
%     portas 22001/22002/22003 = bombas de infusao 1/2/3 (frame binario)
%   Mensagens recebidas sao convertidas em chunks (1 por variavel/alarme, no
%   formato legado !#EQKIND..., ate 10 chars cada), empacotados em frames VLC
%   de ate MAX_FRAME_CHARS separados por '|' (ex.: !#MDHR0090|!#VAMX11|!#1A07)
%   e transmitidos por um canal VLC REAL (Manchester OOK, osciloscopio MDO3012 como DAC/ADC, usando
%   a biblioteca src/main). Apos o canal, o frame e decodificado e o dado
%   clinico/alarme e exibido no console e enviado ao backend (mae_frontend).
%   Os comandos do frontend (silenciar/refresh dos alarmes das bombas) chegam
%   pelo mesmo gateway TCP do backend e sao escritos DIRETO no socket do
%   equipamento alvo, sem passar pela FIFO nem pelo VLC.
%   CTRL+C encerra.
%
%   API PARA A INTERFACE (TestEopSystemView):
%     handles = real_time_mae_vlc('start', opts)
%     result  = real_time_mae_vlc('tick')
%     real_time_mae_vlc('stop')
%   opts pode trazer analyzer/vlcSystem/parameters ja criados pela UI
%   (nao reabre a sessao VISA) e plotEvery (ex.: 10) para calcular olho/Q.
%
%   CAPTURA PARA DIAGRAMA DE OLHO
%   Com config.SAVE_SIGNALS (ligado por padrao), a forma de onda recebida de
%   CADA frame e acrescentada a um vetor e gravada em config.SIGNAL_FILE
%   (data/figures/mae_vlc_capture.mat). O .mat guarda a variavel 'capture':
%     capture.signals  cell 1xN, uma waveform por frame (vetor de amostras)
%     capture.fs       1xN taxa de amostragem de cada waveform (Hz)
%     capture.sps      1xN amostras por chip (metade do bit) de cada waveform
%     capture.meta     1xN struct: iteration, stamp, frame, frameRx, ber, q,
%                      synched, nSamples
%     capture.info     struct: metadados do run (bitRate, resampleFactor,
%                      samplesPerChip, txSampleRate, nFrames, savedAt, ...)
%   As amostras gravadas sao as de response.synchSignal (o RX normalizado pelo
%   pico, reamostrado para a taxa do TX e alinhado com o TX), ou seja, ja na
%   grade de chips: e o que o diagrama de olho precisa. Para desenhar, use o
%   script offline eye_diagram_from_capture.m, que chama eye_diagram_exp com
%   'Manchester', true e sps = capture.sps.

    if nargin >= 1 && (ischar(arg1) || (isstring(arg1) && isscalar(arg1)))
        cmd = lower(strtrim(char(arg1)));
        if any(strcmp(cmd, {'start', 'tick', 'stop'}))
            switch cmd
                case 'start'
                    opts = struct();
                    if nargin >= 2
                        opts = arg2;
                    end
                    handles = maeStart(opts);
                    if nargout > 0
                        varargout{1} = handles;
                    end
                case 'tick'
                    varargout{1} = maeTick();
                case 'stop'
                    maeStop();
            end
            return;
        end
    end

    demoMode = false;
    runSeconds = Inf;
    if nargin >= 1 && ~isempty(arg1)
        demoMode = arg1;
    end
    if nargin >= 2 && ~isempty(arg2)
        runSeconds = arg2;
    end

    opts = struct('demoMode', demoMode, 'plotEvery', Inf);
    maeStart(opts);
    stopCleanup = onCleanup(@() maeStop()); 
    fprintf('[%s] CTRL+C para encerrar.\n', stamp());
    t0 = tic;
    while true
        if isfinite(runSeconds) && toc(t0) > runSeconds
            fprintf('[%s] Encerrando apos %.1f s.\n', stamp(), runSeconds);
            break;
        end
        maeTick();
        state = getappdata(0, 'maeVlcState');
        pause(state.config.TX_INTERVAL_SEC);
    end
end

function handles = maeStart(opts)
    if nargin < 1 || isempty(opts)
        opts = struct();
    end

    root = projectRoot();
    addpath(fullfile(root, 'src', 'scripts', 'alarm-care-pro'));
    addpath(genpath(fullfile(root, 'src', 'main')));

    demoMode = false;
    if isfield(opts, 'demoMode') && ~isempty(opts.demoMode)
        demoMode = logical(opts.demoMode);
    end

    plotEvery = Inf;
    if isfield(opts, 'plotEvery') && ~isempty(opts.plotEvery)
        plotEvery = opts.plotEvery;
    end

    afgAmplitude = 1;
    if isfield(opts, 'afgAmplitude') && ~isempty(opts.afgAmplitude)
        afgAmplitude = opts.afgAmplitude;
    end

    config = struct( ...
        'TX_INTERVAL_SEC', 0.01, ...
        'DEMO_TX_INTERVAL_SEC', 0.15, ...
        'MAX_FRAME_CHARS', 58, ...
        'MAX_FIFO_CHUNKS', 6, ...
        'DEMO_MODE', demoMode, ...
        'DEMO_BASE', fullfile(root, 'example-files'), ...
        'SAVE_SIGNALS', false, ...
        'SIGNAL_FILE', fullfile(root, 'data', 'figures', 'mae_vlc_capture.mat'), ...
        'SIGNAL_SAVE_EVERY_SEC', 30, ...
        'SIGNAL_MAX_SIGNALS', 2000, ...
        'PLOT_EVERY', plotEvery, ...
        'AFG_AMPLITUDE', afgAmplitude);

    ownsAnalyzer = true;
    hasExistingLink = isfield(opts, 'analyzer') && ~isempty(opts.analyzer) ...
        && isfield(opts, 'vlcSystem') && ~isempty(opts.vlcSystem) ...
        && isfield(opts, 'parameters') && ~isempty(opts.parameters);
    if hasExistingLink
        txRxAnalyzer = opts.analyzer;
        vlcSystem = opts.vlcSystem;
        parameters = opts.parameters;
        ownsAnalyzer = false;
    else
        [txRxAnalyzer, vlcSystem, parameters] = setupVlcLink();
    end

    % Amplitude fixa do AFG no modo MAE continuo (sem varredura).
    try
        txRxAnalyzer.setAfgAmplitude(config.AFG_AMPLITUDE);
    catch
    end

    % No modo demo nao ha canal fisico: guardar waveforms so encheria o .mat
    % com sinais sinteticos e travaria a UI nas gravacoes periodicas.
    if config.DEMO_MODE
        config.SAVE_SIGNALS = false;
    end
    initCapture(config, parameters);

    % Fila sempre comeca vazia (evita sobras de um run anterior).
    setappdata(0, 'maeFifo', {});

    demoFrames = {};
    if config.DEMO_MODE
        % Replay continuo: as mensagens dos example-files sao reenfileiradas
        % sempre que a fila esvazia (ver maeTick), em vez de rodar so uma vez.
        mae_frontend().setCommandHandler([]);
        demoFrames = setupDemo(config);
    else
        resetTcpState();
        ensureServers();
        mae_frontend().setCommandHandler(@commandToEquipment);
    end

    state = struct();
    state.config = config;
    state.txRxAnalyzer = txRxAnalyzer;
    state.vlcSystem = vlcSystem;
    state.parameters = parameters;
    state.ownsAnalyzer = ownsAnalyzer;
    state.demoFrames = demoFrames;
    state.iteration = 0;
    state.lastTxTime = -Inf;
    state.t0 = tic;
    setappdata(0, 'maeVlcState', state);
    handles = state;

    fprintf('[%s] real_time_mae_vlc ativo (TX interval %.2f s).\n', ...
        stamp(), config.TX_INTERVAL_SEC);
end

function result = maeTick()
    result = struct('didTx', false, 'response', [], 'iteration', 0, ...
        'frame', '', 'tSec', 0, 'qVal', NaN, 'shouldPlot', false, ...
        'syncOk', false, 'ber', NaN);

    state = getappdata(0, 'maeVlcState');
    if isempty(state)
        return;
    end
    result.tSec = toc(state.t0);
    result.iteration = state.iteration;

    % Ritmo do modo demo: sem hardware, transmitir um frame a cada tick
    % (50 ms) deixaria a UI atualizando mensagens rapido demais. O intervalo
    % tambem da tempo de renderizar os graficos a cada plotEvery frames.
    if state.config.DEMO_MODE && (result.tSec - state.lastTxTime) < state.config.DEMO_TX_INTERVAL_SEC
        return;
    end

    frame = fifoPopBatch(state.config.MAX_FRAME_CHARS);
    if isempty(frame) && state.config.DEMO_MODE && ~isempty(state.demoFrames)
        % Modo demo: ao esvaziar, recarrega as mensagens dos example-files
        % para a execucao continuar (graficos e mensagens seguem evoluindo).
        for i = 1:numel(state.demoFrames)
            fifoPush(state.demoFrames{i});
        end
        frame = fifoPopBatch(state.config.MAX_FRAME_CHARS);
    end
    if isempty(frame)
        return;
    end

    state.iteration = state.iteration + 1;
    setappdata(0, 'maeVlcState', state);

    doEval = shouldEvaluate(state.iteration, state.config.PLOT_EVERY);
    [response, qVal] = transmitAndShow(frame, state.iteration, ...
        state.txRxAnalyzer, state.vlcSystem, state.config, doEval);

    result.didTx = true;
    result.response = response;
    result.iteration = state.iteration;
    result.frame = frame;
    result.tSec = toc(state.t0);
    result.qVal = qVal;
    result.shouldPlot = doEval;
    state.lastTxTime = result.tSec;
    setappdata(0, 'maeVlcState', state);
    if ~isempty(response)
        result.syncOk = logical(response.synchSuccessful);
        if ~isempty(response.ber)
            result.ber = double(response.ber);
        end
    end
end

function maeStop()
    state = getappdata(0, 'maeVlcState');
    if isempty(state)
        return;
    end
    try
        saveCapture(state.config, true);
    catch
    end
    try
        stopTcpServers();
    catch
    end
    if isfield(state, 'ownsAnalyzer') && state.ownsAnalyzer
        cleanupAnalyzer(state.txRxAnalyzer);
    end
    try
        rmappdata(0, 'maeVlcState');
    catch
    end
end

function tf = shouldEvaluate(iteration, everyN)
    if ~isfinite(everyN) || everyN <= 0
        tf = false;
        return;
    end
    tf = (mod(iteration, everyN) == 0);
end

% ---------------------------------------------------------------------------
% Comunicacao VLC real (adaptado de run_manchester_simulation_synccorr_clinic_variables.m)
% ---------------------------------------------------------------------------

function [txRxAnalyzer, vlcSystem, parameters] = setupVlcLink()
    parameters = ManchesterOokParameters();
    encoder = ManchesterOokEncoder(parameters);
    decoder = ManchesterOokDecoder(parameters);

    % Limpa sessoes VISA orfas de execucoes anteriores. O MATLAB mantem todos
    % os objetos de instrumento criados ate que sejam fechados/deletados;
    % execucoes abortadas acumulam sessoes e geram "Unable to create VISA object".
    cleanupOrphanInstruments();

    txRxAnalyzer = Mdo3012Analyzer("USB::0x0699::0x0408::C024549::INSTR");

    % Tenta a conexao inicial com retry, liberando sessoes remanescentes entre
    % tentativas e dando um respiro ao driver VISA.
    maxConnectionAttempts = 5;
    connectionDelay = 2.0;
    for attempt = 1:maxConnectionAttempts
        try
            txRxAnalyzer.initiateDefaultConnection();
            break;
        catch ME
            if attempt == maxConnectionAttempts
                cleanupAnalyzer(txRxAnalyzer);
                error(['Falha ao conectar no MDO apos %d tentativas:\n%s\n\n', ...
                    'Se o erro persistir, feche o MATLAB, reinicie o servico '...
                    'VISA (TekVISA/NI-VISA) e recoloque o cabo USB do '...
                    'osciloscopio.'], maxConnectionAttempts, ME.message);
            end
            fprintf('[conexao] Tentativa %d/%d falhou (%s). Tentando novamente em %ds...\n', ...
                attempt, maxConnectionAttempts, ME.message, connectionDelay);
            cleanupOrphanInstruments();
            pause(connectionDelay);
        end
    end

    vlcSystem = System1tx1rx(encoder, decoder, txRxAnalyzer, txRxAnalyzer);
end

function cleanupOrphanInstruments()
    % Fecha e remove todos os objetos de instrumento registrados no MATLAB,
    % liberando as sessoes VISA presas por execucoes anteriores abortadas.
    try
        orphanObjects = instrfind;
        if ~isempty(orphanObjects)
            try
                fclose(orphanObjects);
            catch
            end
            try
                delete(orphanObjects);
            catch
            end
        end
    catch
    end
end

function connected = isAnalyzerConnected(analyzer)
    connected = false;
    try
        connected = analyzer.isConnected();
    catch
    end
end

function setupAnalyzer(analyzer, afgAmplitude)
    if nargin < 2 || isempty(afgAmplitude)
        afgAmplitude = 1;
    end
    if ~isAnalyzerConnected(analyzer)
        analyzer.connect();
    end
    analyzer.flush();
    analyzer.setMdoAfgOutputState(MdoStateEnum.ON);
    analyzer.setMdoAfgImpedance(MdoAfgImpedanceEnum.HIGHZ);
    analyzer.setMdoAfgFunction(MdoAfgFunctionEnum.ARBITRARY);
    analyzer.setMdoAfgOffset(0);
    analyzer.setAfgAmplitude(afgAmplitude);
    analyzer.setMdoTermination(1, MdoTerminationEnum.MEG);
    analyzer.setMdoTermination(2, MdoTerminationEnum.MEG);
    analyzer.setMdoCoupling(1, MdoCouplingEnum.AC);
    analyzer.setMdoCoupling(2, MdoCouplingEnum.AC);
    analyzer.setMdoHorizontalScale(analyzer.getHorizontalScale());
end

function cleanupAnalyzer(analyzer)
    try
        if isAnalyzerConnected(analyzer)
            analyzer.disconnect();
        end
    catch
    end
end

% ---------------------------------------------------------------------------
% Modo demo (opcional): alimenta a FIFO a partir de example-files, sem TCP
% ---------------------------------------------------------------------------

function frames = setupDemo(config)
    mh = mae_handlers();
    setappdata(0, 'maeTcpMh', mh);
    frames = {};
    frames = [frames, demoEnfileira(mh, fullfile(config.DEMO_BASE, 'monitor', 'file(1).hl7'), '')];
    frames = [frames, demoEnfileira(mh, fullfile(config.DEMO_BASE, 'ventilator', 'file141.hl7'), '')];
    frames = [frames, demoEnfileira(mh, fullfile(config.DEMO_BASE, 'ventilator', 'alarm1.hl7'), '')];
    frames = [frames, demoEnfileira(mh, fullfile(config.DEMO_BASE, 'bomb', 'file1.txt'), 'Bomb1')];
end

function frames = demoEnfileira(mh, arquivo, tipo)
    frames = {};
    if ~isfile(arquivo)
        fprintf('demo: arquivo ausente: %s\n', arquivo);
        return;
    end
    [~, ~, ext] = fileparts(arquivo);
    if strcmp(ext, '.txt')
        fid = fopen(arquivo, 'rb');
        raw = fread(fid, Inf, 'uint8').';
        fclose(fid);
        msg = mh.handleBombData(raw, tipo);
    else
        raw = fileread(arquivo);
        raw = raw(raw ~= char(11) & raw ~= char(26));
        if contains(raw, 'Ventilator')
            msg = mh.handleVentilatorData(raw);
        else
            msg = mh.handleMonitorData(raw);
        end
    end
    frames = enqueue(msg);
    fprintf('demo: %s carregado\n', arquivo);
end

% ---------------------------------------------------------------------------
% Servidores TCP (adaptado do real_time_reading_tcp.m)
% ---------------------------------------------------------------------------

function ensureServers()
    if isequal(getappdata(0, 'maeTcpStarted'), true)
        return;
    end
    setappdata(0, 'maeTcpStarted', true);

    mh = mae_handlers();
    setappdata(0, 'maeTcpMh', mh);

    localhostIp = getenv('SERVER_IP');
    if isempty(localhostIp)
        localhostIp = '0.0.0.0';
    end

    portas = {2222, 'monitor'; 23000, 'ventilador'; ...
        22001, 'bomb1'; 22002, 'bomb2'; 22003, 'bomb3'};
    servers = struct();
    for i = 1:size(portas, 1)
        porta = portas{i, 1};
        nome = portas{i, 2};
        try
            srv = tcpserver(localhostIp, porta);
            srv.ConnectionChangedFcn = @(src, evt) connectionCallback(src, evt);
            switch nome
                case 'monitor'
                    configureCallback(srv, 'byte', 1, @monitorCallback);
                case 'ventilador'
                    configureCallback(srv, 'byte', 1, @ventilatorCallback);
                otherwise
                    configureCallback(srv, 'byte', 1, @(src, ~) bombCallback(src, porta, ['Bomb' nome(end)]));
            end
            servers.(nome) = srv;
            fprintf('[%s] Servidor TCP pronto: %s na porta %d\n', stamp(), nome, porta);
        catch err
            fprintf('[%s] Aviso: nao foi possivel criar o servidor %s na porta %d: %s\n', ...
                stamp(), nome, porta, err.message);
        end
    end
    setappdata(0, 'maeTcpServers', servers);
end

function connectionCallback(src, evt)
    if evt.Connected
        fprintf('[%s] Nova conexao TCP na porta %d\n', stamp(), src.ServerPort);
    else
        fprintf('[%s] Conexao TCP encerrada (porta %d)\n', stamp(), src.ServerPort);
    end
end

function monitorCallback(src, ~)
    if src.NumBytesAvailable <= 0
        return;
    end
    try
        data = char(read(src, src.NumBytesAvailable));
        processHl7(2222, data, false);
    catch err
        fprintf('[%s] Erro no monitor: %s\n', stamp(), err.message);
    end
end

function ventilatorCallback(src, ~)
    if src.NumBytesAvailable <= 0
        return;
    end
    try
        data = char(read(src, src.NumBytesAvailable));
        processHl7(23000, data, true);
    catch err
        fprintf('[%s] Erro no ventilador: %s\n', stamp(), err.message);
    end
end

function bombCallback(src, porta, nome)
    if src.NumBytesAvailable <= 0
        return;
    end
    try
        data = uint8(read(src, src.NumBytesAvailable));
        processBomb(porta, data, nome);
    catch err
        fprintf('[%s] Erro na %s: %s\n', stamp(), nome, err.message);
    end
end

% ---------------------------------------------------------------------------
% Downlink: comando do frontend direto no socket do equipamento
% ---------------------------------------------------------------------------

function commandToEquipment(target, bytes)
%COMMANDTOEQUIPMENT Escreve o comando recebido do gateway direto no equipamento.
%   target = nome do equipamento em maeTcpServers ('bomb1'|'bomb2'|'bomb3')
%   bytes  = frame binario do protocolo SAM Manager, ja em uint8
%
%   O comando NAO entra na FIFO e NAO e transmitido pelo canal VLC: vai
%   direto para o socket TCP do equipamento conectado na porta correspondente
%   (22001/22002/22003), igual o DeviceServer fazia no caminho legado.
    servers = getappdata(0, 'maeTcpServers');
    if isempty(servers) || ~isstruct(servers) || ~isfield(servers, target)
        fprintf('[%s] Comando para "%s" descartado: equipamento sem servidor TCP.\n', ...
            stamp(), target);
        return;
    end
    srv = servers.(target);
    if ~isvalid(srv) || ~srv.Connected
        fprintf('[%s] Comando para "%s" descartado: equipamento desconectado.\n', ...
            stamp(), target);
        return;
    end
    try
        write(srv, bytes, 'uint8');
        fprintf('[%s] Comando direto para %s: %d bytes na porta %d.\n', ...
            stamp(), target, numel(bytes), srv.ServerPort);
    catch err
        fprintf('[%s] Falha ao escrever o comando em %s: %s\n', stamp(), target, err.message);
    end
end

% ---------------------------------------------------------------------------
% Buffer por porta + parse + enfileiramento na FIFO
% ---------------------------------------------------------------------------

function processHl7(porta, data, isVent)
    buf = getBuffer(porta);
    agora = now;
    if ~isempty(buf.data) && agora - buf.ts > 8 / 86400
        buf.data = '';
    end
    buf.data = appendIfNew(buf.data, data);
    if numel(buf.data) > 65536
        buf.data = buf.data(end - 32767:end);
    end
    mh = getappdata(0, 'maeTcpMh');
    if isVent
        msg = mh.handleVentilatorData(buf.data);
    else
        msg = mh.handleMonitorData(buf.data);
    end
    if isempty(msg.variables) && isempty(msg.alarms)
        buf.ts = agora;
        setBuffer(porta, buf);
        return;
    end
    setBuffer(porta, struct('data', '', 'ts', agora));
    enqueue(msg);
end

function processBomb(porta, data, nome)
    buf = getBuffer(porta);
    agora = now;
    if ~isempty(buf.data) && agora - buf.ts > 8 / 86400
        buf.data = uint8([]);
    end
    buf.data = appendIfNew(buf.data, data(:).');
    if numel(buf.data) > 256
        buf.data = buf.data(end - 127:end);
    end
    mh = getappdata(0, 'maeTcpMh');
    try
        msg = mh.handleBombData(buf.data, nome);
    catch
        buf.ts = agora;
        setBuffer(porta, buf);
        return;
    end
    % O numero de serie vem do pacote cru e NAO cabe no frame VLC (limite de
    % 10 chars). Memoriza-se aqui para o mae_frontend poder incluir no payload
    % que o front-end usa para montar o comando silenciar/refresh.
    if isfield(msg, 'deviceId') && ~isempty(msg.deviceId)
        mae_frontend().setPumpSerial(nome(end), msg.deviceId);
    end
    setBuffer(porta, struct('data', uint8([]), 'ts', agora));
    enqueue(msg);
end

function frames = enqueue(msg)
    fr = mae_frame();
    frames = fr.encode(msg);
    for i = 1:numel(frames)
        fifoPush(frames{i});
    end
end

function buf = getBuffer(porta)
    buf = getappdata(0, sprintf('maeTcpBuf%d', porta));
    if isempty(buf)
        buf = struct('data', '', 'ts', now);
    end
end

function setBuffer(porta, buf)
    setappdata(0, sprintf('maeTcpBuf%d', porta), buf);
end

function out = appendIfNew(bufData, data)
    n = numel(data);
    if isempty(bufData) || n == 0
        out = [bufData, data];
        return;
    end
    if numel(bufData) >= n
        tail = bufData(end - n + 1:end);
        if isequal(tail, data)
            out = bufData;
            return;
        end
    end
    out = [bufData, data];
end

% ---------------------------------------------------------------------------
% FIFO (via appdata) e transmissao pelo canal VLC real
% ---------------------------------------------------------------------------

function fifoPush(frame)
    q = getappdata(0, 'maeFifo');
    if isempty(q)
        q = {frame};
    else
        q{end + 1} = frame;
    end
    state = getappdata(0, 'maeVlcState');
    maxChunks = 6;
    if ~isempty(state) && isfield(state, 'config') && isfield(state.config, 'MAX_FIFO_CHUNKS')
        maxChunks = state.config.MAX_FIFO_CHUNKS;
    end
    extra = numel(q) - maxChunks;
    if extra > 0
        q(1:extra) = [];
    end
    setappdata(0, 'maeFifo', q);
end

function frame = fifoPopBatch(maxLen)
%FIFOPOPBATCH Retira da fila quantos chunks couberem em um frame de ate maxLen
%   caracteres (guloso) e retorna o frame empacotado com '|'. Fila vazia -> ''.
    q = getappdata(0, 'maeFifo');
    if isempty(q)
        frame = '';
        return;
    end
    fr = mae_frame();
    take = {};
    curLen = 0;
    for i = 1:numel(q)
        added = numel(q{i});
        if i > 1
            added = added + 1; % separador '|'
        end
        if i > 1 && curLen + added > maxLen
            break;
        end
        take{end + 1} = q{i}; %#ok<AGROW>
        curLen = curLen + added;
    end
    if numel(take) < numel(q)
        q = q(numel(take) + 1:end);
    else
        q = {};
    end
    setappdata(0, 'maeFifo', q);
    packedCell = fr.pack(take, maxLen);
    if isempty(packedCell)
        frame = '';
    else
        frame = packedCell{1};
    end
end

function [response, qVal] = transmitAndShow(frame, iteration, txRxAnalyzer, vlcSystem, config, doEval)
    % Converte o frame em bits no padrao Manchester (header de 8 bits de
    % comprimento + 8 bits por caractere, MSB-first), identico ao
    % run_manchester_simulation_synccorr_clinic_variables.m: os bits da
    % mensagem sao transmitidos diretamente, SEM padding.
    if nargin < 6 || isempty(doEval)
        doEval = false;
    end
    response = [];
    qVal = NaN;
    bits = stringToBits(frame);

    % Reconecta automaticamente (sem recriar os objetos VISA) se a sessao caiu.
    if ~isAnalyzerConnected(txRxAnalyzer)
        setupAnalyzer(txRxAnalyzer, config.AFG_AMPLITUDE);
    end

    try
        response = vlcSystem.communicate(bits, doEval);
    catch ME
        fprintf('[%s] [%04d] Erro na transmissao VLC do frame "%s": %s\n', ...
            stamp(), iteration, frame, ME.message);
        return;
    end

    if ~response.synchSuccessful
        fprintf('[%s] [%04d] SINC FALHOU no frame "%s".\n', stamp(), iteration, frame);
        % Registra a tentativa mesmo sem waveform: sem o sync nao ha amostra
        % alinhada em chip, mas o contador de falhas no .mat mostra quantos
        % frames o canal perdeu. captureSignal ja trata synchSignal vazio.
        captureSignal(response, frame, '', iteration, NaN, config);
        return;
    end

    n = min(numel(response.rxBits), numel(bits));
    frameRx = bitsToString(response.rxBits(1:n));
    if ~isempty(response.qFactor)
        qVal = response.qFactor.getQ();
    end
    % Uma unica captura por frame (antes havia uma chamada extra antes do
    % teste de sync, o que duplicava cada waveform no .mat).
    captureSignal(response, frame, frameRx, iteration, qVal, config);
    fprintf('[%s] [%04d] Tx: %s  |  Rx: %s  |  BER: %.2e  |  Q: %.4f\n', ...
        stamp(), iteration, frame, frameRx, response.ber, qVal);
    if ~strcmp(frameRx, frame)
        fprintf('[%s] FRAME corrompido no canal: "%s" -> "%s"\n', stamp(), frame, frameRx);
    end
    show(frameRx);
end

function bits = stringToBits(message)
    lengthVal = numel(message);
    bits = zeros(1, 8 + 8 * lengthVal);
    idx = 1;
    for i = 7:-1:0
        bits(idx) = bitand(bitshift(lengthVal, -i), 1);
        idx = idx + 1;
    end
    for k = 1:lengthVal
        byte = double(message(k));
        for i = 7:-1:0
            bits(idx) = bitand(bitshift(byte, -i), 1);
            idx = idx + 1;
        end
    end
end

function message = bitsToString(bits)
    bits = bits(:).';
    if numel(bits) < 8
        message = '';
        return;
    end
    lengthVal = 0;
    for i = 1:8
        lengthVal = bitshift(lengthVal, 1) + bits(i);
    end
    charsOut = '';
    for i = 0:lengthVal - 1
        if (i + 1) * 8 > numel(bits) - 8
            break;
        end
        byte = 0;
        for j = 1:8
            byte = bitshift(byte, 1) + bits(8 + i * 8 + j);
        end
        charsOut(end + 1) = char(byte); %#ok<AGROW>
    end
    message = charsOut;
end

% ---------------------------------------------------------------------------
% Captura das waveforms recebidas (-> .mat para o diagrama de olho)
% ---------------------------------------------------------------------------

function initCapture(config, parameters)
%INITCAPTURE Cria o acumulador vazio e ja grava o .mat, para que o arquivo
%   exista desde o comeco da execucao. Cada execucao comeca um .mat novo: as
%   waveforms de runs anteriores sao sobrescritas (apague o arquivo antes se
%   quiser preserva-las).
    capture = struct();
    capture.signals = cell(1, 0);          % 1 x N, uma waveform por frame
    capture.fs      = [];                   % 1 x N taxa de amostragem (Hz)
    capture.sps     = [];                   % 1 x N amostras por chip
    capture.meta    = struct('iteration', {}, 'stamp', {}, 'frame', {}, ...
                             'frameRx', {}, 'ber', {}, 'q', {}, 'synched', {}, ...
                             'nSamples', {});
    capture.info    = struct( ...
        'createdAt',        datestr(now, 'yyyy-mm-dd HH:MM:SS'), ...
        'savedAtDatenum',   now, ...
        'nFrames',          0, ...
        'nFailedSync',      0, ...
        'demoMode',         config.DEMO_MODE, ...
        'maxFrameChars',    config.MAX_FRAME_CHARS, ...
        'bitRate',          parameters.bitRate, ...
        'resampleFactor',   parameters.resampleFactor, ...
        'samplesPerChip',   parameters.resampleFactor / 2, ...
        'txSampleRate',     parameters.txSampleRate, ...
        'note',             ['samples = response.synchSignal.getSamples(): RX ' ...
            'normalizado pelo pico, reamostrado para a taxa do TX e alinhado ' ...
            'com o TX (grade de chips). sps = amostras por chip = metade do ' ...
            'bit; use eye_diagram_exp com ''Manchester'', true e sps = capture.sps.']);
    setappdata(0, 'maeCapture', capture);

    outDir = fileparts(config.SIGNAL_FILE);
    if ~isempty(outDir) && ~isfolder(outDir)
        mkdir(outDir);
    end
    saveCapture(config, true);
end

function captureSignal(response, frame, frameRx, iteration, qVal, config)
%CAPTURESIGNAL Acrescenta a waveform recebida do frame ao acumulador.
%   Grava response.synchSignal, que ja esta na grade de chips (ver initCapture).
%   Frames sem sincronizacao entram com amostras vazias, para o .mat registrar
%   as perdas do canal.
    if ~config.SAVE_SIGNALS
        return;
    end
    capture = getappdata(0, 'maeCapture');
    if isempty(capture)
        return;
    end
    if numel(capture.signals) >= config.SIGNAL_MAX_SIGNALS
        if mod(numel(capture.signals), 100) == 0
            warning('real_time_mae_vlc:captureFull', ...
                ['Limite de %d capturas atingido (config.SIGNAL_MAX_SIGNALS). ' ...
                 'As mensagens seguintes NAO estao sendo salvas; aumente o limite ' ...
                 'ou reduza TX_INTERVAL_SEC.'], config.SIGNAL_MAX_SIGNALS);
        end
        return;
    end

    samples = [];
    fs = NaN;
    sps = NaN;
    synched = ~isempty(response) && ~isempty(response.synchSignal);
    if synched
        samples = double(response.synchSignal.getSamples()).';
        fs = double(response.synchSignal.getSampleRate());
        if ~isempty(response.parameters)
            sps = response.parameters.resampleFactor / 2;
        end
    end

    k = numel(capture.signals) + 1;
    capture.signals{k} = samples;
    capture.fs(k) = fs;
    capture.sps(k) = sps;
    capture.meta(k).iteration = iteration;
    capture.meta(k).stamp = stamp();
    capture.meta(k).frame = frame;
    capture.meta(k).frameRx = frameRx;
    capture.meta(k).ber = NaN;
    capture.meta(k).q = qVal;
    capture.meta(k).synched = synched;
    capture.meta(k).nSamples = numel(samples);
    % communicate so atribui ber depois de passar pelo sync; sem sync o campo
    % fica vazio e o .mat registra NaN para nao misturar tipos na tabela.
    if synched && ~isempty(response.ber)
        capture.meta(k).ber = double(response.ber);
    end
    setappdata(0, 'maeCapture', capture);

    % Flush periodico por tempo (e nao por contagem): cada gravacao reescreve o
    % .mat inteiro, entao salvar a cada frame ficaria caro em runs longos.
    % now e em dias; SIGNAL_SAVE_EVERY_SEC e em segundos.
    if (now - capture.info.savedAtDatenum) * 86400 >= config.SIGNAL_SAVE_EVERY_SEC
        saveCapture(config, false);
    end
end

function saveCapture(config, verbose)
%SAVECAPTURE Grava o acumulador em config.SIGNAL_FILE (formato -v7.3, para
%   aguentar as centenas de milhares de amostras de um run longo sem o limite
%   de 2 GB do formato classico).
    if nargin < 2
        verbose = false;
    end
    if ~config.SAVE_SIGNALS
        return;
    end
    capture = getappdata(0, 'maeCapture');
    if isempty(capture)
        return;
    end
    nFailed = sum(~[capture.meta.synched]);
    capture.info.nFrames = numel(capture.signals);
    capture.info.nFailedSync = nFailed;
    capture.info.savedAt = datestr(now, 'yyyy-mm-dd HH:MM:SS');
    capture.info.savedAtDatenum = now;
    try
        save(config.SIGNAL_FILE, 'capture', '-v7.3');
    catch err
        fprintf('[%s] Falha ao salvar as capturas em "%s": %s\n', ...
            stamp(), config.SIGNAL_FILE, err.message);
        return;
    end
    if verbose
        fprintf('[%s] Capturas salvas: %d waveforms (%d sem sync) em %s\n', ...
            stamp(), numel(capture.signals), nFailed, config.SIGNAL_FILE);
    end
end

% ---------------------------------------------------------------------------
% Decodificacao e exibicao
% ---------------------------------------------------------------------------

function show(frame)
    fr = mae_frame();
    chunks = fr.unpack(frame);
    if isempty(chunks)
        return;
    end
    parsedOk = {};
    for i = 1:numel(chunks)
        parsed = fr.decode(chunks{i});
        if parsed.valid
            parsedOk{end + 1} = parsed; %#ok<AGROW>
        end
    end
    if isempty(parsedOk)
        return;
    end
    if ~isDemoRun()
        mf = mae_frontend();
        mf.sendDecodedBatch(parsedOk);
    end
end

function showMessage(parsed)
    % No modo demo nao existe backend/gateway: nao tenta abrir o socket 4455
    % (a tentativa de conexao bloqueia a UI por alguns segundos).
    if ~isDemoRun()
        mf = mae_frontend();
        mf.sendDecodedPayload(parsed);
    end

    reg = mae_registry();
    eqName = reg.eqName(parsed.eq);
    if parsed.kind == 'D'
        [name, unit, scale] = reg.lookupVariableByAbbr(parsed.eq, parsed.abbr);
        if isempty(name)
            fprintf('[%s] %s variavel desconhecida <%s> valor=%d\n', stamp(), ...
                eqName, parsed.abbr, parsed.valueNum);
            return;
        end
        fprintf('[%s] %s %s = %s %s\n', stamp(), eqName, name, ...
            formatValue(parsed.valueNum, scale), strrep(unit, char(186), char(176)));
    else
        if parsed.eq == 'V'
            desc = reg.alarmAbbrToDesc(parsed.abbr);
            if isempty(desc)
                desc = ['Alarme desconhecido ' parsed.abbr];
            end
            if parsed.state == '1'
                st = 'ATIVO';
            else
                st = 'INATIVO';
            end
            fprintf('[%s] %s %s | %s | %s\n', stamp(), eqName, desc, st, ...
                priNumToText(str2double(parsed.pri)));
        else
            if parsed.pumpIndex == 0
                fprintf('[%s] %s NAO HA ALARMES ATIVOS\n', stamp(), eqName);
            else
                fprintf('[%s] %s %s | ATIVO\n', stamp(), eqName, reg.pumpDesc(parsed.pumpIndex));
            end
        end
    end
end

function tf = isDemoRun()
%ISDEMORUN Verdadeiro quando a pipeline ativa esta no modo demo (sem gateway).
    tf = false;
    state = getappdata(0, 'maeVlcState');
    if ~isempty(state) && isfield(state, 'config') && isfield(state.config, 'DEMO_MODE')
        tf = logical(state.config.DEMO_MODE);
    end
end

function out = formatValue(n, scale)
    if scale == 100
        out = stripZeros(sprintf('%.2f', n / 100));
    else
        out = num2str(n);
    end
end

function s = stripZeros(s)
    if any(s == '.')
        k = numel(s);
        while k > 1 && s(k) == '0'
            k = k - 1;
        end
        s = s(1:k);
        if s(end) == '.'
            s = s(1:end - 1);
        end
    end
end

function t = priNumToText(n)
    switch n
        case 1
            t = 'MED';
        case 2
            t = 'HI';
        case 3
            t = 'LO';
        otherwise
            t = '';
    end
end

function s = stamp()
    s = datestr(now, 'HH:MM:SS');
end

function root = projectRoot()
    root = fullfile(fileparts(fileparts(fileparts(fileparts(mfilename('fullpath'))))));
end

% ---------------------------------------------------------------------------
% Encerramento
% ---------------------------------------------------------------------------

function stopTcpServers()
    cleanupServerObjects();
    try
        rmappdata(0, 'maeTcpStarted');
    catch
    end
    for porta = [2222, 23000, 22001, 22002, 22003]
        try
            rmappdata(0, sprintf('maeTcpBuf%d', porta));
        catch
        end
    end
    setappdata(0, 'maeFifo', {});
    mf = mae_frontend();
    mf.setCommandHandler([]);
    mf.close();
    fprintf('[%s] Servidores TCP encerrados.\n', stamp());
end

function resetTcpState()
    cleanupServerObjects();
    mae_frontend().setCommandHandler([]);
    try
        rmappdata(0, 'maeTcpServers');
    catch
    end
    try
        rmappdata(0, 'maeTcpMh');
    catch
    end
    try
        rmappdata(0, 'maeTcpStarted');
    catch
    end
    try
        rmappdata(0, 'maePumpSerials');
    catch
    end
    for porta = [2222, 23000, 22001, 22002, 22003]
        try
            rmappdata(0, sprintf('maeTcpBuf%d', porta));
        catch
        end
    end
    setappdata(0, 'maeFifo', {});
end

function cleanupServerObjects()
    servers = getappdata(0, 'maeTcpServers');
    if ~isempty(servers) && isstruct(servers)
        nomes = fieldnames(servers);
        for i = 1:numel(nomes)
            obj = servers.(nomes{i});
            if isvalid(obj)
                try
                    delete(obj);
                catch
                end
            end
        end
    end
end